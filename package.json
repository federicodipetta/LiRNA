{
  "name": "lirna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/react/vite.config.ts",
    "dev:react": "vite --config apps/react/vite.config.ts",
    "build": "npm run build --workspace @lirna/sequence && npm run build --workspace @lirna/parser && npm run build --workspace @lirna/cli && npm run build:react",
    "build:react": "tsc -p apps/react/tsconfig.json && vite build --config apps/react/vite.config.ts",
    "test": "npm run build --workspaces --if-present && vitest run",
    "preview": "vite preview --config apps/react/vite.config.ts",
    "tauri": "tauri --config apps/react/src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@lirna/parser": "0.1.0",
    "@lirna/sequence": "0.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "z3-solver": "^4.16.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^2.1.9"
  }
}
